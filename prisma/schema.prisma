generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// accessRole values (kept in sync with src/lib/roles.ts):
// "TECHNICIAN" | "SUPERVISOR" | "QA_MANAGER" | "ADMIN"
model User {
  id            String   @id @default(cuid())
  employeeId    String   @unique
  email         String   @unique
  passwordHash  String
  name          String
  initials      String
  role          String
  section       String
  accessRole    String   @default("TECHNICIAN")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  // Bumped every time the user's password changes (self or admin reset).
  // Sessions embed the version that was current when they were issued, so a
  // password change invalidates every previously-issued cookie.
  sessionVersion      Int      @default(0)

  notifications Notification[]
  auditLogs     AuditLog[]
  mobileRefreshTokens MobileRefreshToken[]
  submittedTests Test[] @relation("TestSubmittedBy")
  correctedTests Test[] @relation("TestCorrectedBy")
  assignedDeviations Deviation[]

  @@index([accessRole])
}

// Refresh tokens for the mobile app's Bearer-token auth (separate from the
// web's cookie session in auth.ts). The raw token is only ever returned to
// the client once, at issuance/rotation — only its hash is stored here, so a
// DB leak doesn't hand out usable tokens. Rotated on every use (the old row
// gets revokedAt + replacedById set, a fresh row is inserted) so a stolen
// token that gets replayed after the legitimate client already rotated it is
// detectable (it'll match a revoked row) instead of silently accepted.
model MobileRefreshToken {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  deviceLabel   String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?
  expiresAt     DateTime
  revokedAt     DateTime?
  replacedById  String?

  @@index([userId])
}

// Sample status values (plain string, kept in sync with src/lib/status.ts):
// "Pending Login" | "In Testing" | "Awaiting Supervisor Review" | "Awaiting QA Approval" | "Complete" | "Rejected"
// priority values: "Routine" | "Urgent" | "STAT"
model Sample {
  id               String    @id
  name             String?
  priority         String    @default("Routine")
  type             String
  sampleTypeId     String?
  sampleType       SampleTypeCatalog? @relation(fields: [sampleTypeId], references: [id], onDelete: SetNull)
  source           String
  status           String
  accessCode       String?   @unique
  requestorName    String?
  businessUnitId   String?
  businessUnit     BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  collectedBy      String
  collectedDate    DateTime
  receivedDate     DateTime
  container        String
  createdAt        DateTime  @default(now())
  approvedBy       String?
  approvedAt       DateTime?
  reviewedByRole   String?
  storageLocation  String?
  retentionUntil   DateTime?
  disposedAt       DateTime?
  retestOfSampleId String?
  retestOf         Sample?   @relation("SampleRetest", fields: [retestOfSampleId], references: [id], onDelete: SetNull)
  retests          Sample[]  @relation("SampleRetest")

  tests         Test[]
  custodyEvents CustodyEvent[]
  notifications Notification[]
  deviations    Deviation[]
  reports       SampleReport[]

  @@index([status])
  @@index([sampleTypeId])
  @@index([retestOfSampleId])
  @@index([businessUnitId])
  // Supports the Samples list's default sort (newest first) and its
  // keyset/cursor pagination, plus the received-date range filter — both
  // need an index to stay fast once this table is large.
  @@index([createdAt])
  @@index([receivedDate])
  // Analytics queries filter on approval window (last-30-days KPI/compliance)
  // and group by type; the daily retention cron filters Complete + retention.
  @@index([approvedAt])
  @@index([type])
  @@index([status, retentionUntil])
}

// A finished lab report document for the whole sample (e.g. a signed-off
// report drafted outside the system) — distinct from TestAttachment, which
// is per-parameter working documentation (raw data, photos) attached while
// a single test is still in progress.
model SampleReport {
  id          String   @id @default(cuid())
  sampleId    String
  sample      Sample   @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  fileName    String
  fileType    String
  fileSize    Int
  storagePath String
  uploadedBy  String
  uploadedAt  DateTime @default(now())

  @@index([sampleId])
}

model BusinessUnit {
  id          String   @id @default(cuid())
  name        String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  // Null until staff explicitly enables the no-login client portal for this
  // BU (opt-in, not automatic) — a long random token, distinct from any
  // sample's accessCode, that lists every sample belonging to this BU.
  // Regenerating it (new random value) is how a leaked link gets cut off.
  portalToken String?  @unique

  samples Sample[]
}

// Test status values: "pending" | "awaiting" | "complete"
// resultMode values: "SINGLE" | "MULTI" (snapshotted from TestCatalog at creation
// so a later catalog edit never changes how an in-flight sample's test behaves)
//
// resultType values: null (legacy — verdict is inferred from the free-text `spec`
// string by lib/spec.ts's regex-based fallback) | "NUMERIC" | "CATEGORICAL" | "TEXT".
// When set, `spec` is still populated (auto-generated by buildSpecLabel, for display
// on the catalog table and the printed CoA) but the verdict is computed from these
// structured fields instead of parsed back out of that string.
// numericMode values: "lte" | "gte" | "range" | "target" | "info" (NUMERIC only).
model Test {
  id             String  @id @default(cuid())
  sampleId       String
  sample         Sample  @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  name           String
  status         String
  result         String?
  unit           String
  spec           String
  notes          String?
  order          Int     @default(0)
  resultMode     String  @default("SINGLE")
  replicateCount Int?
  intervalPlan   String?

  resultType             String?
  numericMode            String?
  numericLimit           Float?
  numericMin             Float?
  numericMax             Float?
  numericTarget          Float?
  numericTolerance       Float?
  categoricalOptions     String?
  categoricalPassOptions String?
  categoricalOrdered     Boolean?
  requiresAttachment     Boolean?

  // Who actually submitted this test's result — null for tests never
  // submitted, or submitted before this field existed. Lets a reviewer's
  // approve/reject notify the technician who did the work, not just the
  // reviewer themself.
  submittedById String?
  submittedBy   User?   @relation("TestSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)

  // Correction trail (typographical-error / transcription fixes on an
  // already-approved result). The previous value is snapshotted here before
  // overwrite so the CoA and audit trail always show what changed; a NULL
  // previousResult means the current result has never been corrected.
  previousResult    String?
  correctionReason  String?
  correctedById     String?
  correctedBy       User?   @relation("TestCorrectedBy", fields: [correctedById], references: [id], onDelete: SetNull)
  correctedAt       DateTime?

  readings    TestReading[]
  attachments TestAttachment[]

  @@index([sampleId])
  @@index([submittedById])
}

// storagePath points to an object in the Supabase Storage bucket configured
// via SUPABASE_STORAGE_BUCKET — never a public URL, since access is brokered
// through short-lived signed URLs generated on read.
model TestAttachment {
  id          String   @id @default(cuid())
  testId      String
  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  fileName    String
  fileType    String
  fileSize    Int
  storagePath String
  uploadedBy  String
  uploadedAt  DateTime @default(now())

  @@index([testId])
}

model TestReading {
  id             String   @id @default(cuid())
  testId         String
  test           Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  intervalLabel  String?
  replicateIndex Int?
  value          String
  note           String?
  enteredBy      String
  takenAt        DateTime @default(now())

  @@index([testId])
}

model CustodyEvent {
  id        String   @id @default(cuid())
  sampleId  String
  sample    Sample   @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  label     String
  detail    String?
  time      DateTime @default(now())
  order     Int      @default(0)

  @@index([sampleId])
  // Dashboard overdue/rejection analytics filter on event time windows.
  @@index([time])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  sampleId  String?
  sample    Sample?  @relation(fields: [sampleId], references: [id], onDelete: SetNull)
  unread    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId, unread])
}

model SampleTypeCatalog {
  id             String   @id @default(cuid())
  name           String   @unique
  targetTatHours Int      @default(48)
  retentionDays  Int      @default(30)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  tests   TestCatalog[]
  samples Sample[]
}

// resultMode values: "SINGLE" | "MULTI"
// intervalPlan: comma-separated checkpoint labels, e.g. "24h,48h,72h" or "Day 1,Day 3,Day 7" (null = no interval plan, just replicates)
// resultType/numericMode/categorical* fields: see the matching comment on Test —
// these are the catalog-level definition that gets snapshotted onto each Test
// created from it, so a later catalog edit never changes an in-flight sample.
model TestCatalog {
  id             String            @id @default(cuid())
  sampleTypeId   String
  sampleType     SampleTypeCatalog @relation(fields: [sampleTypeId], references: [id], onDelete: Cascade)
  name           String
  unit           String
  spec           String
  method         String?
  active         Boolean           @default(true)
  order          Int               @default(0)
  resultMode     String            @default("SINGLE")
  replicateCount Int?
  intervalPlan   String?

  resultType             String?
  numericMode            String?
  numericLimit           Float?
  numericMin             Float?
  numericMax             Float?
  numericTarget          Float?
  numericTolerance       Float?
  categoricalOptions     String?
  categoricalPassOptions String?
  categoricalOrdered     Boolean?
  requiresAttachment     Boolean?

  @@index([sampleTypeId])
}

// An admin-curated shortcut for sample creation: "add these N tests at
// once" instead of picking each one individually. testCatalogIds is a
// simple JSON string array (matches this codebase's preference for a JSON
// list over a join table for small, admin-managed, low-churn data — see
// TestCatalog.categoricalOptions for the same pattern in a single field).
model TestPanel {
  id             String   @id @default(cuid())
  name           String   @unique
  active         Boolean  @default(true)
  testCatalogIds Json
  createdAt      DateTime @default(now())
}

// status values: "Operational" | "Under Maintenance" | "Out of Service"
model Equipment {
  id                 String    @id @default(cuid())
  name               String
  assetTag           String    @unique
  status             String    @default("Operational")
  location           String?
  locationId         String?
  storageLocation    StorageLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  lastCalibratedAt   DateTime?
  nextCalibrationDue DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  events EquipmentEvent[]

  @@index([nextCalibrationDue])
  @@index([locationId])
  @@index([status])
  // Supports the Equipment list's default sort (by name) and its
  // keyset/cursor pagination.
  @@index([name])
}

// type values: "CALIBRATION" | "MAINTENANCE" | "STATUS_CHANGE"
model EquipmentEvent {
  id            String    @id @default(cuid())
  equipmentId   String
  equipment     Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  type          String
  detail        String?
  performedBy   String
  performedAt   DateTime  @default(now())
  nextDueAt     DateTime?
  attachmentFileName    String?
  attachmentFileType    String?
  attachmentFileSize    Int?
  attachmentStoragePath String?

  @@index([equipmentId])
}

// category values: "Reagent" | "Chemical" | "Consumable" | "Media"
model Reagent {
  id              String    @id @default(cuid())
  name            String
  category        String    @default("Reagent")
  lotNumber       String
  quantity        Float
  unit            String
  minStockLevel   Float     @default(0)
  expiryDate      DateTime?
  location        String?
  locationId      String?
  storageLocation StorageLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  transactions ReagentTransaction[]

  @@index([expiryDate])
  @@index([locationId])
  @@index([category])
  // Supports the Reagents list's default sort (by name) and its
  // keyset/cursor pagination.
  @@index([name])
}

// type values: "RECEIVED" | "CONSUMED" | "ADJUSTED" | "DISPOSED"
model ReagentTransaction {
  id             String   @id @default(cuid())
  reagentId      String
  reagent        Reagent  @relation(fields: [reagentId], references: [id], onDelete: Cascade)
  type           String
  quantityChange Float
  quantityAfter  Float
  reason         String?
  performedBy    String
  performedAt    DateTime @default(now())

  @@index([reagentId])
}

// The "Warehouse" catalog — a browsable, nestable tree of physical storage
// locations shared by Reagents and Equipment (e.g. "KBI" > "Microbiology
// Lab" > "Rak X"), so both can be tracked down to an exact spot.
model StorageLocation {
  id        String   @id @default(cuid())
  name      String
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  parentId  String?
  parent    StorageLocation?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  StorageLocation[] @relation("LocationHierarchy")

  reagents  Reagent[]
  equipment Equipment[]

  @@unique([parentId, name])
  @@index([parentId])
}

// metadata: optional structured before/after diff, shape
// { [fieldName]: { from: unknown, to: unknown } } — only populated at the
// highest-value call sites (status transitions, role/active toggles).
// `detail` stays the plain free-text summary everywhere else; the two are
// independent, not migrated into each other.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  detail     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  // BI / anomaly detection filters on action + time window (e.g. all
  // test.result_submitted events in the last 90 days). The createdAt index
  // alone can't narrow by action — with hundreds of thousands of log rows
  // this composite is what keeps those queries from full-scanning.
  @@index([action, createdAt])
}

// entityType values: "SAMPLE" | "EQUIPMENT" | "REAGENT"
// Polymorphic like AuditLog (no FK — one tag maps to a row in one of three
// different tables). `token` is the opaque value written into the physical
// tag's NDEF payload and is what a scan looks up; `serialNumber` is the
// chip's own hardware UID, captured at registration time so a tag whose
// NDEF content later gets overwritten or wiped by something else can still
// be recognized as "known, but tampered" on next read instead of just
// "unknown tag".
model NfcTag {
  id                String    @id @default(cuid())
  token             String    @unique
  serialNumber      String?
  entityType        String
  entityId          String
  active            Boolean   @default(true)
  registeredBy      String
  registeredAt      DateTime  @default(now())
  deactivatedBy     String?
  deactivatedAt     DateTime?
  deactivatedReason String?

  @@index([entityType, entityId])
  @@index([entityType, entityId, active])
}

// status values: "Open" | "Investigating" | "Closed"
// severity values: "Minor" | "Major" | "Critical" (null = not yet triaged)
model Deviation {
  id          String    @id @default(cuid())
  sampleId    String
  sample      Sample    @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  description String
  rootCause   String?
  capa        String?
  status      String    @default("Open")
  openedBy    String
  openedAt    DateTime  @default(now())
  closedAt    DateTime?

  assigneeId String?
  assignee   User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate    DateTime?
  severity   String?

  @@index([sampleId])
  @@index([status])
  @@index([assigneeId])
}

// Atomic counter backing getNextSampleId() — a single row that is
// increment-updated inside a transaction so two concurrent sample creations
// can never read the same max and both be handed the same Sample ID.
model SampleIdCounter {
  id        String @id
  lastValue Int    @default(144)
}
