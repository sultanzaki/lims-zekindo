generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// accessRole values (kept in sync with src/lib/roles.ts):
// "TECHNICIAN" | "SUPERVISOR" | "QA_MANAGER" | "ADMIN"
model User {
  id            String   @id @default(cuid())
  employeeId    String   @unique
  email         String   @unique
  passwordHash  String
  name          String
  initials      String
  role          String
  section       String
  accessRole    String   @default("TECHNICIAN")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?

  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([accessRole])
}

// Sample status values (plain string, kept in sync with src/lib/status.ts):
// "Pending Login" | "In Testing" | "Awaiting Supervisor Review" | "Awaiting QA Approval" | "Complete" | "Rejected"
// priority values: "Routine" | "Urgent" | "STAT"
model Sample {
  id               String    @id
  name             String?
  priority         String    @default("Routine")
  type             String
  sampleTypeId     String?
  sampleType       SampleTypeCatalog? @relation(fields: [sampleTypeId], references: [id], onDelete: SetNull)
  source           String
  status           String
  collectedBy      String
  collectedDate    DateTime
  receivedDate     DateTime
  container        String
  createdAt        DateTime  @default(now())
  approvedBy       String?
  approvedAt       DateTime?
  storageLocation  String?
  retentionUntil   DateTime?
  disposedAt       DateTime?
  retestOfSampleId String?
  retestOf         Sample?   @relation("SampleRetest", fields: [retestOfSampleId], references: [id], onDelete: SetNull)
  retests          Sample[]  @relation("SampleRetest")

  tests         Test[]
  custodyEvents CustodyEvent[]
  notifications Notification[]
  deviations    Deviation[]

  @@index([status])
  @@index([sampleTypeId])
  @@index([retestOfSampleId])
}

// Test status values: "pending" | "awaiting" | "complete"
// resultMode values: "SINGLE" | "MULTI" (snapshotted from TestCatalog at creation
// so a later catalog edit never changes how an in-flight sample's test behaves)
model Test {
  id             String  @id @default(cuid())
  sampleId       String
  sample         Sample  @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  name           String
  status         String
  result         String?
  unit           String
  spec           String
  notes          String?
  order          Int     @default(0)
  resultMode     String  @default("SINGLE")
  replicateCount Int?
  intervalPlan   String?

  readings    TestReading[]
  attachments TestAttachment[]

  @@index([sampleId])
}

// storagePath points to an object in the Supabase Storage bucket configured
// via SUPABASE_STORAGE_BUCKET — never a public URL, since access is brokered
// through short-lived signed URLs generated on read.
model TestAttachment {
  id          String   @id @default(cuid())
  testId      String
  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  fileName    String
  fileType    String
  fileSize    Int
  storagePath String
  uploadedBy  String
  uploadedAt  DateTime @default(now())

  @@index([testId])
}

model TestReading {
  id             String   @id @default(cuid())
  testId         String
  test           Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  intervalLabel  String?
  replicateIndex Int?
  value          String
  note           String?
  enteredBy      String
  takenAt        DateTime @default(now())

  @@index([testId])
}

model CustodyEvent {
  id        String   @id @default(cuid())
  sampleId  String
  sample    Sample   @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  label     String
  detail    String?
  time      DateTime @default(now())
  order     Int      @default(0)

  @@index([sampleId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  sampleId  String?
  sample    Sample?  @relation(fields: [sampleId], references: [id], onDelete: SetNull)
  unread    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId, unread])
}

model SampleTypeCatalog {
  id             String   @id @default(cuid())
  name           String   @unique
  targetTatHours Int      @default(48)
  retentionDays  Int      @default(30)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  tests   TestCatalog[]
  samples Sample[]
}

// resultMode values: "SINGLE" | "MULTI"
// intervalPlan: comma-separated checkpoint labels, e.g. "24h,48h,72h" or "Day 1,Day 3,Day 7" (null = no interval plan, just replicates)
model TestCatalog {
  id             String            @id @default(cuid())
  sampleTypeId   String
  sampleType     SampleTypeCatalog @relation(fields: [sampleTypeId], references: [id], onDelete: Cascade)
  name           String
  unit           String
  spec           String
  method         String?
  active         Boolean           @default(true)
  order          Int               @default(0)
  resultMode     String            @default("SINGLE")
  replicateCount Int?
  intervalPlan   String?

  @@index([sampleTypeId])
}

// status values: "Operational" | "Under Maintenance" | "Out of Service"
model Equipment {
  id                 String    @id @default(cuid())
  name               String
  assetTag           String    @unique
  status             String    @default("Operational")
  location           String?
  lastCalibratedAt   DateTime?
  nextCalibrationDue DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([nextCalibrationDue])
}

model Reagent {
  id            String    @id @default(cuid())
  name          String
  lotNumber     String
  quantity      Float
  unit          String
  minStockLevel Float     @default(0)
  expiryDate    DateTime?
  location      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([expiryDate])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// status values: "Open" | "Investigating" | "Closed"
model Deviation {
  id          String    @id @default(cuid())
  sampleId    String
  sample      Sample    @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  description String
  rootCause   String?
  capa        String?
  status      String    @default("Open")
  openedBy    String
  openedAt    DateTime  @default(now())
  closedAt    DateTime?

  @@index([sampleId])
  @@index([status])
}
