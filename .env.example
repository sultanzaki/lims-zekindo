# Supabase connection strings — Project Settings → Database → Connection string
# DATABASE_URL: pooled connection (Transaction mode, port 6543) — used at runtime
# DIRECT_URL:   direct connection (port 5432) — used by `prisma migrate`
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

SESSION_SECRET="change-me-to-a-long-random-string"
